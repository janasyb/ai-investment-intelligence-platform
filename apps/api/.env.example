APP_NAME=AI Investment Intelligence Platform
APP_VERSION=0.1.0-alpha

ENVIRONMENT=development

DEBUG=true

HOST=0.0.0.0
PORT=8000

LOG_LEVEL=INFO

SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aiip

REDIS_URL=redis://localhost:6379/0

# AIIP-017 Internal Operations Authentication
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
AUTH0_AUDIENCE=
AUTH0_SCOPE=openid profile email
AUTH0_OPERATOR_SUBJECT=

AUTH0_SESSION_COOKIE_NAME=aiip_operator_session
AUTH0_SESSION_TTL_SECONDS=3600
AUTH0_SESSION_IDLE_TTL_SECONDS=1800
AUTH0_SECURE_COOKIE=false
